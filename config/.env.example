# ════════════════════════════════════════════════════════════════════
# SACC-POC-Triage Environment Configuration
# ════════════════════════════════════════════════════════════════════
# Copy this file to .env and edit as needed.
# The triage pipeline uses real SAP Document AI APIs for document extraction.
# All values below are optional unless you need to customise company config
# or thresholds.

# ── Company Configuration ───────────────────────────────────────────
CONFIGURED_COMPANY_CODE=1000
CONFIGURED_COMPANY_NAME=SACC Airlines
CONFIGURED_COMPANY_VAT=
CONFIGURED_COMPANY_TAX_IDS=

# ── Intercompany Company Codes (comma-separated) ────────────────────
INTERCOMPANY_COMPANY_CODES=2000,3000

# ── Confidence Thresholds ───────────────────────────────────────────
MIN_CONFIDENCE_THRESHOLD=0.75
MIN_REQUIRED_FIELD_CONFIDENCE=0.80

# ── Paths (optional overrides) ─────────────────────────────────────
# TRIAGE_CONFIG_DIR=./config
# TRIAGE_DATA_DIR=./data

# ── SAP Document AI API ─────────────────────────────────────────────
# SAP_DOCAI_UAA_URL=https://xxx.authentication.in30.hana.ondemand.com
# SAP_DOCAI_CLIENT_ID_ENV=sb-xxxxx
# SAP_DOCAI_CLIENT_SECRET_ENV=xxxxx
# SAP_DOCAI_BASE_URL_ENV=https://in30.doc.cloud.sap
# SAP_DOX_SCHEMA_ID=your-schema-id-here  # bypass schema lookup if API returns 404

# ── Optional: LLM Configuration ─────────────────────────────────────
# LLM_MODEL_NAME=gpt-4
# LLM_API_KEY=
# LLM_BASE_URL=

# ── Email Intake Agent (required for live email fetching) ──────────
# GRAPH_USER_ID=sacc.ap.invoice@addo.ai
# GRAPH_API_TOKEN=12346789abcdefgh
# GRAPH_API_BASE_URL=https://graph.microsoft.com

# ── Email Scoring Weights (tunable) ────────────────────────────────
# SUBJECT_DOC_TYPE_POINTS=20
# BODY_DOC_TYPE_POINTS=20
# HAS_ATTACHMENT_POINTS=30
# ATTACHMENT_DOC_TYPE_POINTS=30
# MIN_SCORE_THRESHOLD=50

# ── Optional: MSAL credentials for real Microsoft Graph ─────────────
# GRAPH_AUTH_MODE=client_credentials
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_PORT=8002
